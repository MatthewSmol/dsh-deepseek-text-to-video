{
  "name": "@local/dsh-genvideo",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "GenVideo \u2014 local Wan 2.2 TI2V-5B ComfyUI video generator with a DSH sidebar panel (3\u00d74s, 10s crossfade, EWA, H.265, audio).",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/**/*.js",
    "python/*.py",
    "python/requirements.txt",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "workflows/*.json",
    "deploy/**"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build:js": "tsc -p tsconfig.json && tsc -p tsconfig.client.json --noEmit",
    "build": "npm run build:js && npm run build:client && node scripts/build-client.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "build:client": "vite build --config vite.config.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.7.2",
    "vite": "^7.3.8",
    "vue": "^3.5.45"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
