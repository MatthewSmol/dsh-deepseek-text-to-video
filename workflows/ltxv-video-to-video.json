  },
  "15": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "positive": [
        "6",
        0
      ],
      "negative": [
        "6",
        1
      ],
      "cfg": 1.0
    }
  },
  "16": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": {{seed}}
    }
  },
  "17": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "16",
        0
      ],
      "guider": [
        "15",
        0
      ],
      "sampler": [
        "12",
        0
      ],
      "sigmas": [
        "14",
        1
      ],
      "latent_image": [
        "11",
        0
      ]
    }
  },
  "18": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": [
        "17",
        0
      ],
      "vae": [
        "1",
        2
      ],
      "tile_size": 256,
      "overlap": 64,
      "temporal_size": 32,
      "temporal_overlap": 8
    }
  },
  "19": {
    "class_type": "UpscaleModelLoader",
    "inputs": {
      "model_name": "2xNomosUni_span_multijpg.safetensors"
    }
  },
  "20": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": {
      "upscale_model": [
        "19",
        0
      ],
      "image": [
        "18",
        0
      ]
    }
  },
  "21": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "20",
        0
      ],
      "upscale_method": "lanczos",
      "width": {{outWidth}},
      "height": {{outHeight}},
      "crop": "disabled"
