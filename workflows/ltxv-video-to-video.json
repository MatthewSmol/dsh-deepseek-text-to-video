      "positive": [
        "4",
        0
      ],
      "negative": [
        "5",
        0
      ],
      "frame_rate": {{fps}}
    }
  },
  "7": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "{{video}}"
    }
  },
  "8": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "7",
        0
      ]
    }
  },
  "9": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "8",
        0
